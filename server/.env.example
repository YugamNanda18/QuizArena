# =======================================================
# QUIZARENA ENTERPRISE - SERVER ENVIRONMENT CONFIGURATION
# =======================================================

# -------------------------------------------------------
# 1. CORE SERVER SETTINGS (MANDATORY)
# -------------------------------------------------------
# The port where the Express HTTP & Socket.IO server listens
# Default: 5000
PORT=5000

# Node environment mode: 'development' or 'production'
# In production, detailed stack traces are suppressed
NODE_ENV=development

# -------------------------------------------------------
# 2. DATABASE PERSISTENCE (MANDATORY)
# -------------------------------------------------------
# MongoDB connection URI (local instance or MongoDB Atlas replica set)
# Format: mongodb://[username:password@]host[:port]/[database]
# Local Default: mongodb://127.0.0.1:27017/quizarena_enterprise
MONGO_URI=mongodb://127.0.0.1:27017/quizarena_enterprise

# -------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (MANDATORY)
# -------------------------------------------------------
# Cryptographic secret used to sign and verify JSON Web Tokens (JWT)
# Must be at least 32 random characters in production!
JWT_SECRET=quizarena_enterprise_super_secure_jwt_secret_key_2026_change_in_production

# JWT Expiration timeframe (e.g. 1d, 7d, 24h)
# Default: 7d
JWT_EXPIRES_IN=7d

# -------------------------------------------------------
# 4. CROSS-ORIGIN RESOURCE SHARING (CORS) (MANDATORY)
# -------------------------------------------------------
# Whitelisted client URL for browser requests and WebSocket handshakes
# For multiple domains in production, use comma-separated list
# Default in local development: http://localhost:5173
CLIENT_URL=http://localhost:5173

# -------------------------------------------------------
# 5. BOOTSTRAP ADMINISTRATOR CREDENTIALS (MANDATORY FOR INITIAL SETUP)
# -------------------------------------------------------
# Used by database seeder to create the initial super-admin account
ADMIN_EMAIL=admin@quizarena.com
ADMIN_PASSWORD=Admin@123456
