# =======================================================
# QUIZARENA ENTERPRISE - CLIENT ENVIRONMENT CONFIGURATION
# =======================================================

# [OPTIONAL] Backend API Base URL
# Default in development: "" (uses Vite proxy /api/v1 -> localhost:5000)
# In production / decoupled deployment: Set to your public server endpoint (e.g. https://api.quizarena.com)
VITE_API_URL=http://localhost:5000

# [OPTIONAL] Real-Time Socket.IO Server Endpoint
# Default in development: "" or "/" (uses Vite websocket proxy)
# In production / decoupled deployment: Set to your Socket.IO endpoint (e.g. https://api.quizarena.com)
VITE_SOCKET_URL=http://localhost:5000

# [OPTIONAL] Initial Default Theme Preset
# Options: light (Titanium Light) | midnight | cyberpunk | emerald | onyx | crimson | nordic | sunset | dracula
# Default: light
VITE_DEFAULT_THEME=light
